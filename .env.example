# Application Environment Variables
PROJECT_NAME="Bulk Certificate Generator"
ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration (Default SQLite with aiosqlite for zero setup)
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/certificates_db
DATABASE_URL="sqlite+aiosqlite:///./certificates.db"

# Storage Settings
STORAGE_DIR="./storage/certificates"

# PDF Worker Pool Settings
MAX_WORKER_THREADS=4
MAX_BATCH_RECIPIENTS=5000

# Logging
LOG_LEVEL="INFO"
